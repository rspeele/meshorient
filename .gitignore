# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- User work files ---
# Scans in, oriented scans out: mesh files are big binaries and belong to a
# project, not to the repo. The synthetic test scan is the one exception (it
# is the test fixture).
*.stl
*.obj
*.ply
!synthetic_frame_scan.stl

# Screenshots dropped in the working folder
*.png

# --- .NET ---
# The mesh rule above is `*.obj`, which matches FILES called *.obj; it does
# nothing about MSBuild's obj/ directories, hence these.
bin/
obj/
*.user
