# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Test artifacts (regenerated by test_pipeline.py / test_gui.py) ---
pipeline_preview.png
gui_step*.png
outline.dxf
test_project.json

# --- CAD export folders (Export CAD writes <out>_cad/) ---
*_cad/

# --- User work files ---
# Scans in, solids out: mesh files are big binaries and belong to a project,
# not to the repo. The synthetic test scan is the one exception (it is the
# default scan path in the GUI and referenced by both test scripts).
*.stl
*.obj
*.ply
!synthetic_frame_scan.stl

# Exported outlines and saved projects. sample_project.json is tracked as the
# documented example; anything else is a user's own frame.
*.dxf
*.json
!sample_project.json

# Build previews / screenshots dropped in the working folder
*.png
